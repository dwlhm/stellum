{
  "name": "stellum",
  "version": "0.1.0",
  "description": "A lightweight router for React with SSR support",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./link": {
      "types": "./dist/link.d.ts",
      "import": "./dist/link.js",
      "require": "./dist/link.cjs"
    },
    "./context": {
      "types": "./dist/context.d.ts",
      "import": "./dist/context.js",
      "require": "./dist/context.cjs"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js",
      "require": "./dist/renderer.cjs"
    },
    "./useRoute": {
      "types": "./dist/useRoute.d.ts",
      "import": "./dist/useRoute.js",
      "require": "./dist/useRoute.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "npm run build"
  },
  "tsup": {
    "entry": [
      "src/index.ts",
      "src/link.tsx",
      "src/context.tsx",
      "src/renderer.tsx",
      "src/useRoute.tsx",
      "src/types.tsx"
    ],
    "format": [
      "esm",
      "cjs"
    ],
    "dts": true,
    "sourcemap": true,
    "clean": true
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "typescript": "^5.0.0"
  },
  "keywords": [
    "react",
    "router",
    "ssr",
    "routing"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/stellum"
  },
  "devDependencies": {
    "@types/node": "^22.15.19",
    "@types/react": "^19.1.4",
    "tsup": "^8.5.0"
  },
  "dependencies": {
    "scheduler": "^0.26.0",
    "use-context-selector": "^2.0.0"
  }
}
